MATRICULA=seu_numero_de_matricula
PASSWORD=sua_senha_do_portal

# Destinatário do boleto (DDI + DDD + número)
CONTATO=5527990000000

# API do WhatsApp (WAHA). Ao rodar pelo docker-compose, o WAHA_URL é sobrescrito
# automaticamente para http://waha:3000 (nome do serviço na rede interna)
WAHA_URL=http://localhost:3000
WAHA_API_KEY=sua_api_key_do_waha
# (Opcional) Nome da sessão no WAHA. Padrão: default
# WAHA_SESSAO=default

# Login do dashboard do WAHA (usado pelo docker-compose)
WAHA_DASHBOARD_USERNAME=seu_usuario
WAHA_DASHBOARD_PASSWORD=sua_senha_forte

# (Opcional) Pasta dos boletos. Padrão: boletos/ dentro do projeto.
# No docker-compose é sobrescrito para /app/boletos.
# ARQUIVO=C:\caminho\para\pasta\boletos

# (Opcional) Modo contínuo: roda a cada X horas. Se omitido, roda uma vez e encerra.
# No docker-compose já é definido como 24.
# INTERVALO_HORAS=24
